# name: 'Voltage'
# preferred_background: 0b0a14
#
# Saturated neon syntax + pager colours, matching the Ghostty `voltage` theme
# and the starship palette. Commands glow pink, strings lime, options cyan,
# errors red; everything structural stays violet so the line reads at a glance.

# command line
fish_color_normal e8e6ff
fish_color_command ff2e97 --bold
fish_color_builtin c43bff --bold
fish_color_function ff2e97 --bold
fish_color_keyword c43bff --bold
fish_color_param e8e6ff
fish_color_option 00e1ff
fish_color_quote 1fff8a
fish_color_redirection ffd400 --bold
fish_color_operator ffd400
fish_color_end c43bff
fish_color_escape ff7a1a --bold
fish_color_variable 5cefff
fish_color_comment 5a5480 --italics
fish_color_error ff2a55 --bold --underline
fish_color_autosuggestion 5a5480
fish_color_valid_path --underline
fish_color_cancel ff2a55
fish_color_selection ffffff --bold --background=3b1f6e
fish_color_search_match ffffff --bold --background=3b1f6e
fish_color_history_current ff2e97 --bold

# used by fish's own prompt helpers (starship draws the real prompt)
fish_color_cwd ff2e97
fish_color_cwd_root ff2a55 --bold --underline
fish_color_user 00e1ff
fish_color_host c43bff
fish_color_host_remote ffd400 --bold
fish_color_status ff2a55

# completion pager
fish_pager_color_progress ffd400 --bold
fish_pager_color_background
fish_pager_color_prefix ff2e97 --bold --underline
fish_pager_color_completion e8e6ff
fish_pager_color_description 8a83b8 --italics
fish_pager_color_secondary_background
fish_pager_color_secondary_prefix ff2e97 --bold --underline
fish_pager_color_secondary_completion cfcbea
fish_pager_color_secondary_description 6e6898 --italics
fish_pager_color_selected_background --background=3b1f6e
fish_pager_color_selected_prefix 5cefff --bold --underline
fish_pager_color_selected_completion ffffff --bold
fish_pager_color_selected_description e07bff
