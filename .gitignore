# This repo is public, so only what is listed here is synced. Everything else
# in ~/.config (browsers, chat apps, password managers, caches, logins) stays
# on the machine. Add a line here to sync a new app.
/*
!/.gitignore
!/dots-sync
!/alacritty/
!/ash/
!/astra/
!/autostart/
!/bash/
!/bat/
!/btop/
!/chrome-flags.conf
!/chromium-flags.conf
!/cliamp/
!/concord/
!/dlv/
!/eza/
!/facetime-enhanced.conf
!/fastfetch/
!/fcitx5/
!/fontconfig/
!/foot/
!/gh/
!/gh-dash/
!/ghostty/
!/git/
!/glow/
!/helix/
!/herdr/
!/htop/
!/hype/
!/hypr/
!/hyprland-mimeapps.list
!/hyprland-preview-share-picker/
!/joy/
!/lazygit/
!/matcha/
!/mimeapps.list
!/obsidian/
!/omacom/
!/Omacom/
!/omarchy/
!/opencode/
!/plain/
!/qtengine/
!/slk/
!/spotatui/
!/ssh/
!/starship.toml
!/systemd/
!/tmux/
!/tmux-sessionizer
!/tmux-status
!/user-dirs.dirs
!/wireplumber/
!/xcompose/
!/xdg-desktop-portal/
!/xdg-terminals.list
!/xkb/
!/yazi/
!/zsh/

# State, logs and backups inside synced folders
*.log
*.lock
*.bak
*.bak-*
*.before-*
._*
/fcitx5/conf/cached_layouts
/htop/htop_history
/omarchy/backup-*/
/omarchy/plugins/superwhisper-panel
/systemd/user/*.wants/
