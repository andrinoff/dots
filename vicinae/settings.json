{
   "$schema": "https://vicinae.com/schemas/config.json",
   "telemetry": {
      "system_info": false
   },
   "pop_to_root_on_close": true,
   "close_on_focus_loss": true,
   "font": {
      "normal": {
         "family": "MonoLisa"
      }
   },
   "theme": {
      "dark": {
         "name": "caelestia"
      }
   },
   "launcher_window": {
      "opacity": 0.92,
      "material": "blur",
      "rounding": 28,
      "compact_mode": {
         "enabled": true
      },
      "clock": {
         "enabled": true,
         "format": "hh:mm:ss",
         "interval": 1
      }
   }
}
