// ─────────────────────────────────────────────────────────────────────────────
// Fastfetch Config
// ─────────────────────────────────────────────────────────────────────────────

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/sketch-tree.png",
    "width": 24,
    "height": 19,
    "padding": { "top": 0, "right": 4, "left": 2 },
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "37",
      "title": "97",
      "output": "97",
      "separator": "34",
    },
    "constants": [
      "\u001b[?7l\u001b[22;34m",
      "\u001b[22;37m",
      "\u001b[22;37m",
      "\u001b[90m",
      "\u001b[0;97m",
      "\u001b[72G\u001b[K \u001b[34m│\u001b[0m\u001b[?7h",
      "\u001b[34G",
      "\u001b[0m\u001b[?7h",
    ],
    "size": { "ndigits": 0 },
    "percent": {
      "type": ["num", "bar"],
      "color": { "green": "32", "yellow": "33", "red": "31" },
    },
    "bar": {
      "char": { "elapsed": "━", "total": "─" },
      "border": null,
      "color": { "elapsed": "32", "total": "90" },
      "width": 8,
    },
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{$1}╭────────────────────────────────────────╮{$7}{$5} \u001b[1;32m{user-name}\u001b[0;90m@\u001b[1;36m{host-name} {$8}",
    },
    {
      "type": "os",
      "key": "{$1}│ \u001b[22;31m  os    ",
      "format": "{name} {codename} {version}{$6}",
    },
    {
      "type": "host",
      "key": "{$1}│ \u001b[22;33m󰌢  host  ",
      "format": "{name:-26}{$6}",
    },
    {
      "type": "kernel",
      "key": "{$1}│ \u001b[22;32m  kernel",
      "format": "{sysname} {release}{$6}",
    },
    {
      "type": "uptime",
      "key": "{$1}│ \u001b[22;36m  uptime",
      "format": "{formatted}{$6}",
    },
    {
      "type": "custom",
      "format": "{$1}├────────────────────────────────────────┤{$8}",
    },
    {
      "type": "command",
      "key": "{$1}│ \u001b[22;34m  wm    ",
      "text": "{hyprland}",
    },
    {
      "type": "terminal",
      "key": "{$1}│ \u001b[22;35m  term  ",
      "format": "{pretty-name} {$4}{version}{$6}",
    },
    {
      "type": "shell",
      "key": "{$1}│ \u001b[22;31m  shell ",
      "format": "{pretty-name} {$4}{version}{$6}",
    },
    {
      "type": "custom",
      "format": "{$1}├────────────────────────────────────────┤{$8}",
    },
    {
      "type": "cpu",
      "key": "{$1}│ \u001b[22;33m  cpu   ",
      "format": "{name} {$4}· {core-types} cores{$6}",
    },
    {
      "type": "memory",
      "key": "{$1}│ \u001b[22;32m  memory",
      "format": "{percentage-bar}{$5} {used} {$4}/ {total}{$6}",
    },
    {
      "type": "disk",
      "key": "{$1}│ \u001b[22;36m󰋊  disk  ",
      "folders": "/",
      "format": "{size-percentage-bar}{$5} {size-used} {$4}/ {size-total}{$6}",
    },
    {
      "type": "battery",
      "key": "{$1}│ \u001b[22;34m󰁹  power ",
      "format": "{capacity-bar}{$5} {capacity} {$4}{status}{$6}",
    },
    {
      "type": "media",
      "key": "{$1}│ \u001b[22;35m󰝚  media ",
      "format": "{title} {$4}· {artist}{$6}",
    },
    {
      "type": "custom",
      "format": "{$1}╰────────────────────────────────────────╯{$8}",
    },
    {
      "type": "custom",
      "format": "{$1} \u001b[90m████ \u001b[31m████ \u001b[32m████ \u001b[33m████ \u001b[34m████ \u001b[35m████ \u001b[36m████ \u001b[37m████{$8}",
    },
    "break",
  ],
}
