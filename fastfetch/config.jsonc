// ─────────────────────────────────────────────────────────────────────────────
// Fastfetch Config
// ─────────────────────────────────────────────────────────────────────────────

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/crewmate.png",
    "width": 24,
    "height": 19,
    "padding": { "top": 0, "right": 4, "left": 2 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;5;244", "title": "97", "output": "97", "separator": "38;5;239" },
    "constants": [
      "\u001b[?7l\u001b[22;38;5;239m",
      "\u001b[22;38;5;250m",
      "\u001b[22;38;5;244m",
      "\u001b[38;5;242m",
      "\u001b[0;97m",
      "\u001b[72G\u001b[K \u001b[38;5;239m│\u001b[0m\u001b[?7h",
      "\u001b[34G",
      "\u001b[0m\u001b[?7h"
    ],
    "size": { "ndigits": 0 },
    "percent": { "type": ["num", "bar", "bar-monochrome"], "color": { "green": "97", "yellow": "97", "red": "7" } },
    "bar": {
      "char": { "elapsed": "━", "total": "─" },
      "border": null,
      "color": { "elapsed": "97", "total": "38;5;238" },
      "width": 8
    }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{$1}╭────────────────────────────────────────╮{$7}{$5} \u001b[1m{user-name}\u001b[0;38;5;244m@\u001b[0;97m{host-name} {$8}" },
    { "type": "os",       "key": "{$1}│ {$2}  {$3}os    ", "format": "{name} {codename} {version}{$6}" },
    { "type": "host",     "key": "{$1}│ {$2}󰌢  {$3}host  ", "format": "{name:-26}{$6}" },
    { "type": "kernel",   "key": "{$1}│ {$2}  {$3}kernel", "format": "{sysname} {release}{$6}" },
    { "type": "uptime",   "key": "{$1}│ {$2}  {$3}uptime", "format": "{formatted}{$6}" },
    { "type": "custom",   "format": "{$1}├────────────────────────────────────────┤{$8}" },
    { "type": "command",  "key": "{$1}│ {$2}  {$3}wm    ", "text": "if pgrep -xq astra; then echo \"astra $(~/.local/bin/astra --version 2>/dev/null | head -1 | cut -d' ' -f2)\"; elif pgrep -xq yabai; then v=$(yabai --version 2>/dev/null); echo \"yabai ${v#yabai-v}\"; else echo quartz; fi", "format": "{}{$6}" },
    { "type": "terminal", "key": "{$1}│ {$2}  {$3}term  ", "format": "{pretty-name} {$4}{version}{$6}" },
    { "type": "shell",    "key": "{$1}│ {$2}  {$3}shell ", "format": "{pretty-name} {$4}{version}{$6}" },
    { "type": "custom",   "format": "{$1}├────────────────────────────────────────┤{$8}" },
    { "type": "cpu",      "key": "{$1}│ {$2}  {$3}cpu   ", "format": "{name} {$4}· {core-types} cores{$6}" },
    { "type": "memory",   "key": "{$1}│ {$2}  {$3}memory", "format": "{percentage-bar}{$5} {used} {$4}/ {total}{$6}" },
    { "type": "disk",     "key": "{$1}│ {$2}󰋊  {$3}disk  ", "folders": "/", "format": "{size-percentage-bar}{$5} {size-used} {$4}/ {size-total}{$6}" },
    { "type": "battery",  "key": "{$1}│ {$2}󰁹  {$3}power ", "format": "{capacity-bar}{$5} {capacity} {$4}{status}{$6}" },
    { "type": "media",    "key": "{$1}│ {$2}󰝚  {$3}media ", "format": "{title} {$4}· {artist}{$6}" },
    { "type": "custom",   "format": "{$1}╰────────────────────────────────────────╯{$8}" },
    { "type": "custom",   "format": "{$1} \u001b[38;5;232m████ \u001b[38;5;235m████ \u001b[38;5;238m████ \u001b[38;5;241m████ \u001b[38;5;245m████ \u001b[38;5;248m████ \u001b[38;5;251m████ \u001b[38;5;255m████{$8}" },
    "break"
  ]
}
