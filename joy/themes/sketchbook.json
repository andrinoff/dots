{
  "name": "sketchbook",
  "dark": true,
  "palette": {
    "paper": "#000000",
    "raised": "#121212",
    "raised2": "#1c1c1c",
    "hair": "#262626",
    "line": "#3a3a3a",
    "muted": "#6b6b6b",
    "secondary": "#a3a3a3",
    "body": "#e4e4e4",
    "bright": "#ffffff",
    "red": "#e07a7a",
    "orange": "#d9a070",
    "yellow": "#d8c87a",
    "green": "#8fc48f",
    "cyan": "#78bfbf",
    "blue": "#8aa4e6",
    "magenta": "#c995d6"
  },
  "styles": {
    "text": "body",
    "muted": "muted",
    "subtle": "line",
    "accent": "bright",
    "accent2": "secondary",
    "border": "hair",
    "border-focus": "bright",

    "line-number": "line",
    "line-number-current": { "fg": "bright", "bold": true },
    "cursor": { "fg": "paper", "bg": "bright" },
    "cursor-normal": { "bg": "bright" },
    "cursor-insert": { "bg": "bright" },
    "cursor-visual": { "bg": "bright" },
    "cursor-visual-line": { "bg": "bright" },
    "cursor-visual-block": { "bg": "bright" },
    "cursor-command": { "bg": "bright" },
    "cursor-replace": { "bg": "bright" },
    "cursor-select": { "bg": "bright" },
    "background": { "fg": "body", "bg": "paper" },
    "selection": { "fg": "bright", "bg": "line" },
    "cursor-line": { "bg": "raised" },
    "sticky-scroll": { "bg": "raised" },
    "symbol-highlight": { "bg": "hair" },
    "yank-highlight": { "bg": "line" },
    "ruler": { "bg": "raised" },
    "match-bracket": { "fg": "bright", "bold": true, "underline": true },
    "status": { "fg": "body", "bg": "raised" },
    "bufferline": { "fg": "muted", "bg": "raised" },
    "bufferline-active": { "fg": "bright", "bold": true },
    "panel": { "fg": "body", "bg": "raised" },
    "panel-focused": { "fg": "paper", "bg": "bright", "bold": true },
    "menu": { "fg": "body", "bg": "raised" },
    "menu-selected": { "fg": "paper", "bg": "bright" },
    "menu-match": { "fg": "bright", "bold": true, "underline": true },
    "menu-detail": "muted",
    "scrollbar": { "bg": "hair" },
    "scrollbar-thumb": { "fg": "hair", "bg": "muted" },
    "popup-title": { "fg": "bright", "bold": true },

    "error": "red",
    "warning": "yellow",
    "info": "blue",
    "hint": "muted",
    "ghost": { "fg": "muted", "italic": true },
    "search-match": { "fg": "paper", "bg": "secondary" },
    "search-current": { "fg": "paper", "bg": "bright", "bold": true },
    "git-add": "green",
    "git-change": "yellow",
    "git-delete": "red",
    "tree-dir": { "fg": "bright", "bold": true },
    "tree-file": "body",
    "tree-current": { "fg": "bright", "bold": true, "underline": true },
    "tree-selected": { "fg": "bright", "bg": "raised2" },
    "picker-match": { "fg": "bright", "bold": true, "underline": true },
    "picker-path": "muted",
    "whitespace": "line",
    "indent-guide": "hair",

    "keyword": "magenta",
    "comment": { "fg": "muted", "italic": true },
    "string": "green",
    "number": "orange",
    "function": "blue",
    "type": "cyan",
    "builtin": { "fg": "red", "italic": true },
    "operator": "secondary",
    "punctuation": "muted",
    "tag": "red",
    "attribute": { "fg": "yellow", "italic": true },
    "parameter": { "fg": "body", "italic": true },
    "property": "body",
    "namespace": "yellow",
    "constant": "orange",
    "inlay-hint": "muted",

    "heading": { "fg": "blue", "bold": true },
    "heading-marker": "muted",
    "emphasis": { "italic": true },
    "strong": { "bold": true },
    "strikethrough": { "strikethrough": true },
    "delimiter": "muted",
    "code": "green",
    "link": { "fg": "cyan", "underline": true },
    "link-url": "muted",
    "list-marker": "orange",
    "quote": { "fg": "secondary", "italic": true }
  }
}
